cover_letter:
  language: "ru"
  max_length: 1800
  style: "professional, гибридный: 2–3 абзаца, 2–3 ключевые цифры на письмо, живой тон без штампов, без отрицаний, без точного стажа, буква «ё» заменена на «е», персонализация под компанию и домен, приветствие «Добрый день!»"
  required_portfolio_url: ""
  closing: "С уважением, Александр Сверинов"
